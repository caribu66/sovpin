KUBO_REPLICA_URLS=
KUBO_GATEWAY_URL=http://100.66.85.86:8080
PUBLIC_GATEWAY_URL=https://ipfs.sovpin.com

# Upload & Edge Limits
# Default 100 MiB (104857600 bytes) matches Cloudflare Free/Pro single-request body limit
