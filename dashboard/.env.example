VERUS_RPC_PORT=25779
VERUS_RPC_USER=test
VERUS_RPC_PASSWORD=test
VERUS_CHAIN=VRSCTEST
VERUS_CHAIN_I_ADDRESS=iJhCezBExJHvtyH3fGhNnt2NhU4Ztkf2yq

# SovPin Server VerusID (dedicated identity for LoginConsent QR sign-in)
SOVPIN_SIGNER_ID=sovpin.VRSCTEST@
SOVPIN_SIGNER_I_ADDRESS=iCyhNFeRiKdX7rgAYJdz54z2pTT9M1RYUt
# WIF for the primary address of sovpin.VRSCTEST@ (RRwpzqXYBuu7Xek96hLjmMDxiG2s6xWPyu)
