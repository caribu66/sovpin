SOVPIN_SIGNER_WIF=  # REQUIRED: set a securely stored WIF; never commit a production WIF
SOVPIN_CALLBACK_HOST=https://dashboard.sovpin.com
# Keep false in production so public internet callers cannot sign challenges using the server's local verusd wallet
ALLOW_PUBLIC_NODE_SIGN=false
ADMIN_IDENTITIES=iEmX7PJUtAwp1a1xxrPi215G7FMxwVr5XX,iCyhNFeRiKdX7rgAYJdz54z2pTT9M1RYUt,vreal.VRSCTEST@,sovpin.VRSCTEST@

# Kubo (Tailscale)
TAILSCALE_IP=100.66.85.86
KUBO_RPC_URL=http://100.66.85.86:5001
